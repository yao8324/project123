  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArcaneArchive.Core.CampaignDefinition
  book: {fileID: 11400000, guid: b401509a51d564c19b20b1c2eb6eaa40, type: 2}
  chapters:
  - title: "\u7B2C\u4E00\u7AE0 \xB7 \u7F1A\u9B42\u8005"
    introduction: "\u707E\u53D8\u540E\uFF0C\u4F60\u5728\u5B88\u85CF\u9662\u9192\u6765\u3002\u84DD\u7EF3\u3001\u5C01\u7AE0\u3001\u6700\u540E\u4E00\u6279\u9057\u8D60\u2014\u2014\u4F60\u8BB0\u5F97\u81EA\u5DF1\u8FD8\u6CA1\u6709\u5B8C\u6210\u5DE5\u4F5C\u3002\n\n\u6536\u5BB9\u5927\u5385\u91CC\uFF0C\u7F1A\u9B42\u8005\u6B63\u5728\u9A71\u4F7F\u4EA1\u7075\u3002\n\u300C\u80FD\u541E\u7EB3\u9B54\u80FD\uFF1F\u4F60\u6B63\u9002\u5408\u66FF\u6211\u7EF4\u6301\u8FD9\u9053\u675F\u7F1A\u3002\u300D\n\n\u5148\u7A81\u7834\u4ED6\u7684\u672F\u5F0F\uFF0C\u6253\u5F00\u64A4\u79BB\u901A\u8DEF\u3002"
    aftermath: "\u675F\u7F1A\u6563\u53BB\uFF0C\u4EA1\u7075\u9000\u56DE\u6536\u5BB9\u951A\u70B9\u3002\n\n\u4F60\u5728\u6863\u6848\u53F0\u540E\u627E\u5230\u9047\u96BE\u8005\u3002\u5979\u6000\u4E2D\u7684\u84DD\u7EF3\u3001\u53D7\u4F24\u7684\u8863\u6599\u3001\u5199\u7740\u300C\u4F0A\u83B1\u6069\u300D\u7684\u5DE5\u4F5C\u724C\uFF0C\u90FD\u4E0E\u4F60\u7684\u8BB0\u5FC6\u543B\u5408\u3002\n\n\u300C\u90A3\u4E9B\u8BB0\u5FC6\u5C5E\u4E8E\u5979\u3002\u6211\u4E0D\u662F\u4F0A\u83B1\u6069\u3002\u300D\n\u5C01\u9986\u8B66\u62A5\u54CD\u8D77\u3002\u5178\u72F1\u957F\u6B63\u5728\u68C0\u67E5\u4F60\u7684\u638C\u7EB9\u3002"
    combat: {fileID: 11400000, guid: 0847bc7e00f25487e884a200b9f7d732, type: 2}
    arena: {fileID: 2720360553675253641, guid: f6ade99a6d86946e39bf477afcc68ac9, type: 3}
    knight: {fileID: 0}
  - title: "\u7B2C\u4E8C\u7AE0 \xB7 \u5178\u72F1\u957F"
    introduction: "\u64A4\u79BB\u540D\u5355\u4E0A\uFF0C\u6709\u4E9B\u540D\u5B57\u5DF2\u88AB\u6807\u8BB0\u4E3A\u300C\u5DF2\u9001\u51FA\u300D\u3002\u5178\u72F1\u957F\u5B88\u7740\u5269\u4E0B\u7684\u901A\u8DEF\u3002\n\n\u300C\u5148\u63A5\u53D7\u6536\u5BB9\u3002\u6211\u4F1A\u6D3E\u4EBA\u5904\u7406\u5269\u4E0B\u7684\u6863\u6848\u3002\u300D\n\u4F60\u4ECD\u8BB0\u5F97\u90A3\u4EFD\u672A\u5B8C\u6210\u7684\u4EA4\u63A5\uFF0C\u4E0D\u613F\u5728\u6B64\u505C\u4E0B\u3002\n\n\u5C01\u9986\u672F\u5F0F\u542F\u52A8\u3002\u6253\u65AD\u6536\u5BB9\uFF0C\u7EE7\u7EED\u524D\u5F80\u6838\u5FC3\u3002"
    aftermath: "\u6536\u5BB9\u672F\u5F0F\u88AB\u6253\u65AD\u3002\u4E8B\u6545\u6284\u4EF6\u5199\u7740\u300C\u5730\u4E0B\u5C01\u5370\u7A7A\u7F6E\u300D\uFF0C\u4F60\u7684\u638C\u90E8\u4E09\u7F3A\u73AF\u7EB9\u4E0E\u5C01\u5370\u5171\u9E23\u3002\n\u300C\u5C01\u5370\u91CC\u7684\u4E1C\u897F\uFF0C\u662F\u6211\u3002\u300D\n\n\u4F60\u7A33\u4F4F\u53D7\u635F\u88C5\u7F6E\uFF0C\u6551\u51FA\u5178\u72F1\u957F\uFF0C\u5F52\u8FD8\u5C01\u9986\u5370\u3002\n\u4ED6\u63A5\u901A\u64A4\u79BB\u56DE\u8DEF\uFF1A\u300C\u5148\u628A\u4ED6\u4EEC\u9001\u51FA\u53BB\u3002\u4E4B\u540E\uFF0C\u4F60\u8DDF\u6211\u8D70\u3002\u300D"
    combat: {fileID: 11400000, guid: 1868d2b08dbe74f78bb69a9cf77abb3c, type: 2}
    arena: {fileID: 2872713533465359254, guid: 704037558e32c4a549a1a638fca0a9c9, type: 3}
    knight: {fileID: 0}
  - title: "\u7B2C\u4E09\u7AE0 \xB7 \u5723\u9A91\u58EB"
    introduction: "\u6838\u5FC3\u5723\u5802\u91CC\uFF0C\u9EC4\u91D1\u7FBD\u7FFC\u6536\u62E2\u5728\u539A\u91CD\u5C01\u5370\u95E8\u524D\u3002\n\u5723\u9A91\u58EB\u51C6\u5907\u5207\u65AD\u5931\u63A7\u7684\u5916\u5C42\u4F9B\u80FD\u3002\n\u300C\u7EE7\u7EED\u8FDE\u63A5\uFF0C\u5371\u9669\u5C31\u4F1A\u8513\u5EF6\u3002\u300D\n\n\u901A\u8BAF\u91CC\u4F20\u6765\u8BF7\u6C42\uFF1A\u64A4\u79BB\u5C1A\u672A\u7ED3\u675F\u3002\n\u4F60\u5FC5\u987B\u4E89\u53D6\u4FEE\u590D\u65F6\u95F4\uFF0C\u8BA9\u5723\u9A91\u58EB\u6682\u505C\u7D27\u6025\u9694\u79BB\u3002"
    aftermath: "\u9EC4\u91D1\u7FBD\u7FFC\u7F13\u7F13\u6536\u62E2\u3002\u5723\u9A91\u58EB\u4ECD\u6D3B\u7740\uFF0C\u7D27\u6025\u9694\u79BB\u6682\u505C\u3002\n\n\u5178\u72F1\u957F\u6062\u590D\u8BBE\u65BD\u6743\u9650\uFF0C\u4F60\u5C06\u5916\u6EA2\u80FD\u91CF\u538B\u56DE\u56DE\u8DEF\u3002\n\u5723\u9A91\u58EB\u770B\u89C1\u7A33\u5B9A\u7684\u8BFB\u6570\uFF0C\u653E\u4E0B\u5251\uFF0C\u5B88\u4F4F\u901A\u8DEF\u3002\n\u6700\u540E\u4E00\u6279\u84DD\u7EF3\u8F6C\u8FD0\u7BB1\u5F00\u59CB\u79BB\u9986\u3002"
    combat: {fileID: 0}
    arena: {fileID: 0}
    knight: {fileID: 11400000, guid: fc958bda6c3ca4b9b989506510aa807b, type: 2}
  endingTitle: "\u7EC8\u7AE0 \xB7 \u5B8C\u6210\u5979\u672A\u5B8C\u6210\u7684\u5DE5\u4F5C"
  ending: "\u5E78\u5B58\u8005\u4E0E\u9057\u8D60\u5B8C\u6210\u64A4\u79BB\uFF0C\u4EA1\u7075\u88AB\u5B89\u5168\u8F6C\u79FB\u3002\u539F\u77F3\u4ECD\u7559\u5728\u6838\u5FC3\uFF0C\u4F9B\u80FD\u6062\u590D\u3002\n\n\u4F60\u4E0D\u662F\u4F0A\u83B1\u6069\uFF0C\u4E5F\u65E0\u6CD5\u62B9\u53BB\u81EA\u5DF1\u7684\u8FC7\u53BB\u3002\n\u4F46\u8FD9\u4E00\u6B21\uFF0C\u4F60\u9009\u62E9\u5B8C\u6210\u5979\u4EA4\u7ED9\u4F60\u7684\u5DE5\u4F5C\u3002\n\n\u90A3\u5C01\u4FE1\u7EC8\u4E8E\u9001\u51FA\uFF1A\u5979\u53EF\u4EE5\u6765\u8BFB\uFF0C\u4E5F\u53EF\u4EE5\u9009\u62E9\u4E0D\u8BFB\u3002\n\n\u4E09\u7AE0\u901A\u5173
    \xB7 \u611F\u8C22\u6E38\u73A9"
