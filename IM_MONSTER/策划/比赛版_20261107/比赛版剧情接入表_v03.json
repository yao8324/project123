  "records": [
    {
      "id": "ARCHIVE_RECORD_01",
      "scene_anchor": "ARCHIVE_RECORD_SLOT_01",
      "title": "百年前的守夜记录",
      "body": "封印落成后的第七夜，守夜人仍能听见岩层深处的震动。百年前的战事已经结束，那头企图夺取源石的怪物没有死去。我们将它留在世界尽头，让源石持续维持镇压。后来，导流设施把逸散的魔能引向地表，守藏院才有了长明的灯。请后来者记住，这里的光依赖一份尚未结束的看守。维护记录不得因年代久远而省略。",
      "summary": "古老封印仍在持续运转。",
      "chinese_character_count": 128,
      "completion": "record_01_verified",
      "completion_control": "核验完成",
      "reading_time_gate": false
    },
    {
      "id": "ARCHIVE_RECORD_02",
      "scene_anchor": "ARCHIVE_RECORD_SLOT_02",
      "title": "自愿遗赠的登记",
      "body": "我愿把修桥时的见闻和这封写给女儿的信留在这里。她可以来读，也可以选择不读。至于我生前用于测量的术式，只交给登记在册的继承人；其他能力随我一同消逝。请封忆师逐项核对我的意愿，不要把记忆当作供人取用的力量。等这份交付完成，我就能安心离开。若供能中断，请先保护已经封存的内容，不要擅自重新开启。",
      "summary": "记忆与能力的遗赠都要尊重本人意愿。",
      "chinese_character_count": 131,
      "completion": "record_02_verified",
      "completion_control": "核验完成",
      "reading_time_gate": false
    },
    {
      "id": "ARCHIVE_RECORD_03",
      "scene_anchor": "ARCHIVE_RECORD_SLOT_03",
      "title": "供能巡检便笺",
      "body": "今天更换了第三路回路的连接片。档案中的记忆并非封好便能永存，维持结构的魔能一旦不足，声音会先断续，随后连熟悉的面孔也会变得模糊。发现灯纹失稳时，应先恢复局部导流，再检查档案供能，最后锁定稳定回路。不要为了抢亮一盏灯耗尽整段余量。每一份看似安静的遗赠，都有人在另一端等着把它带回家。",
      "summary": "维护顺序为导流、档案供能、稳定回路。",
      "chinese_character_count": 128,
      "completion": "record_03_verified",
      "completion_control": "核验完成",
      "reading_time_gate": false
    }
  ],
  "incident_record": {
    "id": "INCIDENT_RECORD",
    "body": "封印监测抄件：“核心封印异常开启，受封对象离位。外逸共鸣呈三缺环纹，残留于掌部。此页只转抄当次读数，不能用于确认其他幸存者身份。”临终记录：“来不及归档了。我自愿留下这段记忆。若有人接到它，请先救那些还没被带走的遗赠。”",
    "requires_first_reveal": true
  },
